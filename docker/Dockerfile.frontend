# PartPilot frontend image.
#
# Build from the root of the repository:
#   docker build -f docker/Dockerfile.frontend -t partpilot-frontend .
#
# The build stage uses node. The serve stage uses nginx. The result is a
# small image with the static files of Vite.

# --------------------------------------------------------------- build ----
FROM node:22-alpine AS build

WORKDIR /app

# The dependency layer changes less often than the code.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# --------------------------------------------------------------- serve ----
FROM nginx:1.27-alpine AS serve

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
