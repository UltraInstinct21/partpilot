# PartPilot - environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be
# committed. All of these values are read on the SERVER only; the browser
# never receives an API key (NFR-02, NFR-07).
#
#   cp .env.example .env

# --- Runtime -----------------------------------------------------------------
PARTPILOT_DATA_DIR=./data
PARTPILOT_DB_PATH=./data/partpilot.db
# PARTPILOT_DATABASE_URL=sqlite:///./data/partpilot.db
PARTPILOT_API_HOST=127.0.0.1
PARTPILOT_API_PORT=8000
# Comma separated list of allowed browser origins.
PARTPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PARTPILOT_MAX_UPLOAD_BYTES=5242880
PARTPILOT_SEARCH_RATE_LIMIT_PER_MINUTE=30

# --- Live web discovery ------------------------------------------------------
# Point this at a self-hosted SearXNG instance. Leave empty for catalogue-only.
# Example: PARTPILOT_SEARXNG_URL=http://127.0.0.1:8080
PARTPILOT_SEARXNG_URL=
PARTPILOT_WEB_SEARCH_TIMEOUT_SECONDS=4
PARTPILOT_WEB_SEARCH_RESULTS=8
PARTPILOT_WEB_DISCOVERY_BUDGET_SECONDS=12
PARTPILOT_PROVIDER_API_DISCOVERY_ENABLED=false

# --- LLM ---------------------------------------------------------------------
# The provider is chosen by config. The LangChain OpenAI provider talks to any
# OpenAI compatible endpoint, so an OpenAI compatible gateway works as well.
#
#   PARTPILOT_LLM_PROVIDER=openai
#
# The base URL and the key are OPTIONAL. When they are empty the provider uses
# its own default URL and the key from its own environment variable
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...). Fill them in to point at another
# endpoint.
PARTPILOT_LLM_PROVIDER=openai
PARTPILOT_LLM_MODEL=gpt-4o-mini
PARTPILOT_LLM_VISION_MODEL=gpt-4o-mini
PARTPILOT_LLM_BASE_URL=
PARTPILOT_LLM_VISION_BASE_URL=
PARTPILOT_LLM_API_KEY=
PARTPILOT_LLM_TEMPERATURE=0
PARTPILOT_LLM_MAX_RETRIES=3
PARTPILOT_LLM_REQUESTS_PER_SECOND=1
PARTPILOT_LLM_CACHE_ENABLED=true
# USD per 1M tokens, used for the cost estimate in the llm_calls table.
PARTPILOT_LLM_COST_PER_MILLION_INPUT=0.15
PARTPILOT_LLM_COST_PER_MILLION_OUTPUT=0.60

# Provider key. Set only the one you use.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- OpenCode Zen (an OpenAI compatible gateway with free models) -----------
# Copy these lines into your `.env` to use it. The key is read from the
# environment, never committed.
#
# PARTPILOT_LLM_PROVIDER=openai
# PARTPILOT_LLM_BASE_URL=http://127.0.0.1:1337/v1
# PARTPILOT_LLM_MODEL=moonshotai/kimi-k2.6:free
# PARTPILOT_LLM_API_KEY=your-zen-key
#
# The model may be any model the gateway serves. A free one is enough for the
# extraction tiers; a bigger model gives a better tier 3 (vision).

# --- DigiKey Product Information v4 ------------------------------------------
# Register an application on https://developer.digikey.com
# The 2-legged flow needs only the client id and secret.
PARTPILOT_DIGIKEY_CLIENT_ID=
PARTPILOT_DIGIKEY_CLIENT_SECRET=
PARTPILOT_DIGIKEY_BASE_URL=https://api.digikey.com
PARTPILOT_DIGIKEY_LOCALE_SITE=US
PARTPILOT_DIGIKEY_LOCALE_LANGUAGE=en
PARTPILOT_DIGIKEY_LOCALE_CURRENCY=USD
# DigiKey documents 120 requests/minute and 1000 requests/day. Stay below.
PARTPILOT_DIGIKEY_RATE_LIMIT_PER_MINUTE=60
PARTPILOT_DIGIKEY_RATE_LIMIT_PER_DAY=800

# --- Nexar (Octopart supply data) -------------------------------------------
# Create an application with the supply scope on https://portal.nexar.com
PARTPILOT_NEXAR_CLIENT_ID=
PARTPILOT_NEXAR_CLIENT_SECRET=
PARTPILOT_NEXAR_TOKEN_URL=https://identity.nexar.com/connect/token
PARTPILOT_NEXAR_GRAPHQL_URL=https://api.nexar.com/graphql
PARTPILOT_NEXAR_SCOPE=supply.domain
PARTPILOT_NEXAR_RATE_LIMIT_PER_MINUTE=60
PARTPILOT_NEXAR_RATE_LIMIT_PER_DAY=800

# --- Mouser Search API -------------------------------------------------------
# Request a Search API key on https://www.mouser.com/api-search/
PARTPILOT_MOUSER_API_KEY=
PARTPILOT_MOUSER_BASE_URL=https://api.mouser.com/api/v1
# Mouser documents 30 requests/minute and 1000 requests/day.
PARTPILOT_MOUSER_RATE_LIMIT_PER_MINUTE=20
PARTPILOT_MOUSER_RATE_LIMIT_PER_DAY=800

# --- Ethics / crawling -------------------------------------------------------
# A clear User-Agent with a contact address. Change the address to yours.
PARTPILOT_USER_AGENT=PartPilot/0.1 (academic research; component data mining; contact: partpilot-contact@example.edu)
# Set to false to remove robots.txt blocking for multi-source scraping and ingestion
PARTPILOT_RESPECT_ROBOTS_TXT=false
# Minimum delay in seconds between two requests to the same host.
PARTPILOT_DOWNLOAD_DELAY_SECONDS=1.0
